# Settings for docker-compose.yaml. `kindling init` writes a filled-in copy to
# .env with generated secrets; if you copy it by hand, fill in the blank
# secrets yourself (e.g. `openssl rand -hex 32`). Never commit .env.

# Images are pinned by digest. To upgrade, change tag and digest together.
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.17.2-full@sha256:f922dce73c12026ce7e6b8e3e0740a657db3162910d4368f67dddc86af8b3d10
POSTGRES_IMAGE=postgres:18.6@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6
# Used by the pii stage, when kindling.yaml's middleware section has one.
PRESIDIO_ANALYZER_IMAGE=mcr.microsoft.com/presidio-analyzer:2.2.362@sha256:286e3fa7f3a7426e775e8564fe1870f1ba8f999d3ab8bbb8cc46a44355d9d6e9
# The edge (`kindling serve`), used when kindling.yaml has a middleware
# section. There's no published image yet: build one from a kindling checkout
# with `docker build -t kindling:local .`
KINDLING_IMAGE=kindling:local

# Where the MLflow UI and gateway listen on the host (not 5000: macOS AirPlay
# Receiver uses it). Keep 127.0.0.1 unless you've put auth in front of it.
MLFLOW_BIND=127.0.0.1
MLFLOW_PORT=5050
# Where the edge listens on the host. Same advice: it has no auth.
KINDLING_PROXY_BIND=127.0.0.1
KINDLING_PROXY_PORT=5060

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=

# Encrypts provider credentials stored in Postgres. Keep it safe: losing or
# changing it makes stored credentials unreadable.
MLFLOW_CRYPTO_KEK_PASSPHRASE=

# Allow the gateway to call model servers on private addresses / plain http.
# kindling turns these on when kindling.yaml has a local connection.
MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS=false
MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES=https

# Provider API keys, referenced from kindling.yaml as ${NAME}.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
